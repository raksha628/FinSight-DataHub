# ═══════════════════════════════════════════════════════════════════
# FinSight DataHub — Environment Variables Template
# Copy this file to .env and fill in your actual values.
#
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_DB=finsight_db
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=YourSecureDbPassword123!

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=YourSecureRedisPassword123!

# ── JWT ────────────────────────────────────────────────────────────
# Must be at least 256-bit (32 characters) Base64-encoded string.
# Generate: openssl rand -base64 64
JWT_SECRET=ReplaceWithYourSecretKeyThatIsAtLeast256BitsLong_GenerateWithOpensslRand
JWT_EXPIRATION_MS=86400000

# ── Gemini AI ──────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Application ────────────────────────────────────────────────────
# Spring active profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── Data Directories (Local Dev) ───────────────────────────────────
# These paths are used by the folder-watcher scheduler.
# In Docker, these are overridden by volume mounts.
DATA_INCOMING_PATH=./data/incoming
DATA_ARCHIVE_PATH=./data/archive
DATA_ERROR_PATH=./data/error
