# ═══════════════════════════════════════════════════════════════════
# FinSight DataHub — Environment Variables Template
# Copy this file to .env and fill in your actual values.
#
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_DB=finsight_db
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=YourSecureDbPassword123!

# ── JWT ────────────────────────────────────────────────────────────
# Must be at least 256-bit (32 characters) Base64-encoded string.
# Generate: openssl rand -base64 64
JWT_SECRET=ReplaceWithYourSecretKeyThatIsAtLeast256BitsLong_GenerateWithOpensslRand
JWT_EXPIRATION_MS=86400000

# ── Application ────────────────────────────────────────────────────
# Spring active profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080


