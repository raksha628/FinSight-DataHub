# ── Java / Maven ─────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
.mvn/

# ── Environment ───────────────────────────────────────────────────────────
.env
*.env.local

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── IDEs ─────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store

# ── Node / React ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Spring Boot static (generated by npm build) ───────────────────────────
backend/src/main/resources/static/

# ── Data files (don't commit ETL data) ───────────────────────────────────
data/incoming/*
data/archive/*
data/error/*
!data/incoming/.gitkeep
!data/archive/.gitkeep
!data/error/.gitkeep
!data/samples/
.env
